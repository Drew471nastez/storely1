<template>
<section class="fw fw-ic" data-scheme="{{ settings.color_scheme }}" style="--fw-bg:{{ scheme.bg }};--fw-title:{{ scheme.heading }};--fw-text:{{ scheme.text }};--fw-muted:{{ scheme.paragraph }};--fw-line:{{ scheme.border }};--fw-accent:{{ scheme.heading }};--fw-button:{{ scheme.primary_btn_bg }};--fw-button-text:{{ scheme.primary_btn_text }};--fw-radius:{{ theme.radius.medium }}px;--fw-top:{{ settings.padding_top }}px;--fw-bottom:{{ settings.padding_bottom }}px;">
 <div class="fw__inner"><div class="fw-ic__intro">{% if settings.eyebrow %}<p class="fw__overline">{{ settings.eyebrow }}</p>{% endif %}<h2 class="fw__heading">{{ settings.heading }}</h2>{% if settings.body %}<p class="fw__lede">{{ settings.body }}</p>{% endif %}</div>
 <div class="fw-ic__area" style="--split:50%">
  <div class="fw-ic__picture fw-ic__picture--before">{% if settings.before_image %}<img src="{{ settings.before_image | asset }}" alt="{{ settings.before_alt }}" loading="lazy">{% else %}<span class="fw-ic__empty">{{ settings.before_label }}</span>{% endif %}</div>
  <div class="fw-ic__picture fw-ic__picture--after">{% if settings.after_image %}<img src="{{ settings.after_image | asset }}" alt="{{ settings.after_alt }}" loading="lazy">{% else %}<span class="fw-ic__empty">{{ settings.after_label }}</span>{% endif %}</div>
  <div class="fw-ic__line" aria-hidden="true"><span>↔</span></div>
  <span class="fw-ic__label fw-ic__label--left">{{ settings.before_label }}</span><span class="fw-ic__label fw-ic__label--right">{{ settings.after_label }}</span>
  <input type="range" min="0" max="100" value="50" step="1" aria-label="Move to compare before and after">
 </div>
 </div>
</section>
</template>

<style scoped>
.fw{background:var(--fw-bg);color:var(--fw-text);container-type:inline-size;}
.fw,.fw *{box-sizing:border-box;}
.fw *{min-width:0;}
.fw img{display:block;max-width:100%;}
.fw a{color:inherit;}
.fw__inner{max-width:var(--theme-page-width,1280px);padding:var(--fw-top) clamp(18px,4vw,48px) var(--fw-bottom);margin-inline:auto;}
.fw__overline{margin:0 0 14px;font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--fw-accent);}
.fw__heading{margin:0;color:var(--fw-title);font-size:clamp(30px,4.2cqi,56px);font-weight:650;line-height:1.12;letter-spacing:-.044em;overflow-wrap:anywhere;}
.fw__lede{max-width:57ch;margin:20px 0 0;font-size:clamp(15px,1.45cqi,18px);line-height:1.7;color:var(--fw-muted);}
.fw__action{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:12px 21px;text-decoration:none;border-radius:var(--fw-radius);font-weight:650;font-size:14px;background:var(--fw-button);color:var(--fw-button-text)!important;border:1px solid var(--fw-button);transition:transform .16s ease,background .16s ease,box-shadow .16s ease;}
.fw__action:hover{transform:translateY(-2px);box-shadow:0 8px 24px #0000001c;}
.fw__action--secondary{background:transparent!important;color:var(--fw-title)!important;border-color:var(--fw-line);}
.fw a:focus-visible,.fw button:focus-visible,.fw summary:focus-visible,.fw input:focus-visible{outline:3px solid var(--fw-accent);outline-offset:4px;}
@media(prefers-reduced-motion:reduce){.fw *, .fw *::before,.fw *::after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important;}}

.fw-ic__intro{max-width:680px;text-align:center;margin:0 auto 32px}.fw-ic__intro .fw__lede{margin-inline:auto}.fw-ic__area{isolation:isolate;position:relative;max-width:1000px;margin-inline:auto;aspect-ratio:1.9;min-height:270px;overflow:hidden;border-radius:16px;background:#c8d5cb}.fw-ic__picture{position:absolute;inset:0;overflow:hidden}.fw-ic__picture>img{width:100%;height:100%;object-fit:cover}.fw-ic__picture--before{background:linear-gradient(140deg,#c6c6c0,#9fafa7)}.fw-ic__picture--after{clip-path:inset(0 0 0 var(--split));background:linear-gradient(130deg,#647e70,#e3e6d9)}.fw-ic__empty{display:grid;place-items:center;height:100%;font-size:clamp(30px,4vw,60px);color:#fff9;font-weight:650;letter-spacing:-.05em}.fw-ic__line{position:absolute;left:var(--split);top:0;bottom:0;width:2px;background:white;transform:translateX(-1px);pointer-events:none}.fw-ic__line span{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);display:grid;place-items:center;background:white;color:#162119;height:50px;width:50px;border-radius:50%;box-shadow:0 4px 30px #0004}.fw-ic__label{position:absolute;z-index:1;top:20px;padding:8px 14px;border-radius:100px;background:#fff;color:#17231c;font-size:12px;font-weight:700;pointer-events:none}.fw-ic__label--left{left:20px}.fw-ic__label--right{right:20px}.fw-ic__area input{position:absolute;inset:0;z-index:4;width:100%;height:100%;opacity:0;cursor:ew-resize}
@container(max-width:600px){.fw-ic__area{aspect-ratio:1.15;min-height:250px}.fw-ic__label{top:12px}.fw-ic__label--left{left:12px}.fw-ic__label--right{right:12px}}
</style>

<script>
// Each section script receives only its own `root` from Storelib's sandbox.
// Never access the page document or attach global event handlers.
const area = root.querySelector('.fw-ic__area');
const slider = area && area.querySelector('input[type="range"]');

if (area && slider) {
  const updateComparison = () => {
    const position = Number(slider.value);
    if (!Number.isFinite(position)) return;
    const percent = Math.min(100, Math.max(0, position));
    area.style.setProperty('--split', percent + '%');
  };

  slider.addEventListener('input', updateComparison);
  slider.addEventListener('change', updateComparison);
  updateComparison();
}
</script>

<schema>
{
  "schema_version": 1,
  "type": "foundation_image_compare",
  "name": "Foundation / Before and after",
  "category": "images",
  "description": "Native browser range slider comparing two images; keyboard accessible, reduced-motion friendly.",
  "version": "1.0.0",
  "icon": "sliders-horizontal",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Overline",
      "default": "THE TRANSFORMATION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See the difference."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Description",
      "default": "Drag the handle to explore the details."
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image",
      "default": ""
    },
    {
      "type": "text",
      "id": "before_alt",
      "label": "Before image description",
      "default": "Before"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image",
      "default": ""
    },
    {
      "type": "text",
      "id": "after_alt",
      "label": "After image description",
      "default": "After"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "After"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "white"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "default": 80,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 80,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Foundation / Before and after"
    }
  ]
}
</schema>
