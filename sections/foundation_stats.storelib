<template>
<section class="fw fw-stats" data-scheme="{{ settings.color_scheme }}" style="--fw-bg:{{ scheme.bg }};--fw-title:{{ scheme.heading }};--fw-text:{{ scheme.text }};--fw-muted:{{ scheme.paragraph }};--fw-line:{{ scheme.border }};--fw-accent:{{ scheme.heading }};--fw-button:{{ scheme.primary_btn_bg }};--fw-button-text:{{ scheme.primary_btn_text }};--fw-radius:{{ theme.radius.medium }}px;--fw-top:{{ settings.padding_top }}px;--fw-bottom:{{ settings.padding_bottom }}px;"><div class="fw__inner fw-stats__inner">
 <div class="fw-stats__intro">{% if settings.eyebrow %}<p class="fw__overline">{{ settings.eyebrow }}</p>{% endif %}<h2 class="fw__heading">{{ settings.heading }}</h2>{% if settings.body %}<p class="fw__lede">{{ settings.body }}</p>{% endif %}</div>
 <div class="fw-stats__grid">{% for block in blocks %}<div class="fw-stats__stat" data-block-id="{{ block.id }}"><strong>{{ block.settings.number }}</strong><span>{{ block.settings.label }}</span></div>{% endfor %}</div>
</div></section>
</template>

<style scoped>
.fw{background:var(--fw-bg);color:var(--fw-text);container-type:inline-size;font-family:var(--theme-font-body),sans-serif;}
.fw,.fw *{box-sizing:border-box;}
.fw *{min-width:0;}
.fw img{display:block;max-width:100%;}
.fw a{color:inherit;}
.fw__inner{max-width:var(--theme-page-width,1280px);padding:var(--fw-top) clamp(18px,4vw,48px) var(--fw-bottom);margin-inline:auto;}
.fw__overline{margin:0 0 14px;font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--fw-accent);}
.fw__heading{margin:0;color:var(--fw-title);font-family:var(--section-heading-font,var(--theme-font-heading)),sans-serif;font-size:var(--section-heading-size,clamp(30px,4.2cqi,56px));font-weight:var(--section-heading-weight,650);line-height:var(--section-heading-line-height,1.12);letter-spacing:var(--section-heading-tracking,-.044em);text-transform:var(--section-heading-transform,none);overflow-wrap:anywhere;}
.fw__lede{max-width:57ch;margin:20px 0 0;font-family:var(--theme-font-body),sans-serif;font-size:var(--section-text-size,clamp(15px,1.45cqi,18px));line-height:var(--section-text-line-height,1.7);color:var(--fw-muted);}
.fw__action{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:var(--sl-button-padding,12px 21px);text-decoration:none;border-radius:var(--theme-button-radius,var(--fw-radius));font-family:var(--theme-font-body),sans-serif;font-weight:var(--type-button-weight,650);font-size:var(--type-button-size,14px);letter-spacing:var(--type-button-tracking,0);text-transform:var(--type-button-transform,none);background:var(--fw-button);color:var(--fw-button-text)!important;border:1px solid var(--fw-button);box-shadow:var(--sl-btn-shadow,none);transition:background-color .18s ease,color .18s ease,border-color .18s ease,box-shadow .18s ease;}
.fw__action:hover{background:var(--scheme-button-primary-hover,var(--fw-button));color:var(--scheme-button-primary-hover-text,var(--fw-button-text))!important;}
.fw__action--secondary{background:transparent!important;color:var(--fw-title)!important;border-color:var(--fw-line);}
.fw a:focus-visible,.fw button:focus-visible,.fw summary:focus-visible,.fw input:focus-visible{outline:3px solid var(--fw-accent);outline-offset:4px;}
@media(prefers-reduced-motion:reduce){.fw *, .fw *::before,.fw *::after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important;}}

.fw-stats__inner{display:grid;grid-template-columns:1fr 1.2fr;gap:6vw;align-items:center}.fw-stats__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px}.fw-stats__stat{padding:15px 0;border-top:1px solid var(--fw-line)}.fw-stats__stat strong{display:block;font-size:clamp(34px,4cqi,58px);font-weight:640;letter-spacing:-.06em;color:var(--fw-title)}.fw-stats__stat span{display:block;font-size:14px;margin-top:8px;color:var(--fw-muted)}
@container(max-width:700px){.fw-stats__inner{grid-template-columns:1fr;gap:34px}.fw-stats__grid{gap:22px}}
</style>

<schema>
{
  "schema_version": 1,
  "type": "foundation_stats",
  "name": "Foundation / Key numbers",
  "category": "text",
  "description": "An editable numbers and statistics bar with blocks, inspired by Materia stats.",
  "version": "1.0.0",
  "icon": "bar-chart",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Overline",
      "default": "A BIT ABOUT US"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A few things worth knowing."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Description",
      "default": "Share real numbers and milestones with your audience."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "light"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "default": 80,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 80,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Scroll animation",
      "default": "none",
      "options": [
        {"value": "theme", "label": "Theme setting"},
        {"value": "none", "label": "None"},
        {"value": "fade", "label": "Fade"},
        {"value": "fade_up", "label": "Fade up"},
        {"value": "rise", "label": "Rise"},
        {"value": "zoom", "label": "Zoom"},
        {"value": "blur", "label": "Blur"},
        {"value": "slide_left", "label": "From the right"},
        {"value": "slide_right", "label": "From the left"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Numbers (edit before publishing)",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "number": "01",
            "label": "Your first milestone"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "02",
            "label": "Another achievement"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "03",
            "label": "A third reason to believe"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "04",
            "label": "And another"
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Value",
          "default": "01"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "A meaningful milestone"
        }
      ]
    }
  ]
}
</schema>
