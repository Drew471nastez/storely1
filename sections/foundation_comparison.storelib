<template>
<section class="fw fw-compare" data-scheme="{{ settings.color_scheme }}" style="--fw-bg:{{ scheme.bg }};--fw-title:{{ scheme.heading }};--fw-text:{{ scheme.text }};--fw-muted:{{ scheme.paragraph }};--fw-line:{{ scheme.border }};--fw-accent:{{ scheme.heading }};--fw-button:{{ scheme.primary_btn_bg }};--fw-button-text:{{ scheme.primary_btn_text }};--fw-radius:{{ theme.radius.medium }}px;--fw-top:{{ settings.padding_top }}px;--fw-bottom:{{ settings.padding_bottom }}px;"><div class="fw__inner">
 <div class="fw-compare__intro">{% if settings.eyebrow %}<p class="fw__overline">{{ settings.eyebrow }}</p>{% endif %}<h2 class="fw__heading">{{ settings.heading }}</h2>{% if settings.body %}<p class="fw__lede">{{ settings.body }}</p>{% endif %}</div>
 <div class="fw-compare__scroll" role="region" tabindex="0" aria-label="{{ settings.heading }}"><table><thead><tr><th scope="col">{{ settings.feature_heading }}</th><th scope="col" class="fw-compare__featured">{{ settings.ours_heading }}</th><th scope="col">{{ settings.theirs_heading }}</th></tr></thead>
 <tbody>{% for block in blocks %}<tr data-block-id="{{ block.id }}"><th scope="row">{{ block.settings.label }}</th><td class="fw-compare__featured">{{ block.settings.ours }}</td><td>{{ block.settings.theirs }}</td></tr>{% endfor %}</tbody></table></div>
 </div></section>
</template>

<style scoped>
.fw{background:var(--fw-bg);color:var(--fw-text);container-type:inline-size;}
.fw,.fw *{box-sizing:border-box;}
.fw *{min-width:0;}
.fw img{display:block;max-width:100%;}
.fw a{color:inherit;}
.fw__inner{max-width:var(--theme-page-width,1280px);padding:var(--fw-top) clamp(18px,4vw,48px) var(--fw-bottom);margin-inline:auto;}
.fw__overline{margin:0 0 14px;font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--fw-accent);}
.fw__heading{margin:0;color:var(--fw-title);font-size:clamp(30px,4.2cqi,56px);font-weight:650;line-height:1.12;letter-spacing:-.044em;overflow-wrap:anywhere;}
.fw__lede{max-width:57ch;margin:20px 0 0;font-size:clamp(15px,1.45cqi,18px);line-height:1.7;color:var(--fw-muted);}
.fw__action{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:12px 21px;text-decoration:none;border-radius:var(--fw-radius);font-weight:650;font-size:14px;background:var(--fw-button);color:var(--fw-button-text)!important;border:1px solid var(--fw-button);transition:transform .16s ease,background .16s ease,box-shadow .16s ease;}
.fw__action:hover{transform:translateY(-2px);box-shadow:0 8px 24px #0000001c;}
.fw__action--secondary{background:transparent!important;color:var(--fw-title)!important;border-color:var(--fw-line);}
.fw a:focus-visible,.fw button:focus-visible,.fw summary:focus-visible,.fw input:focus-visible{outline:3px solid var(--fw-accent);outline-offset:4px;}
@media(prefers-reduced-motion:reduce){.fw *, .fw *::before,.fw *::after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important;}}

.fw-compare__intro{max-width:750px;margin:0 auto 36px;text-align:center}.fw-compare__intro .fw__lede{margin-inline:auto}.fw-compare__scroll{overflow-x:auto;max-width:100%;border-radius:14px;border:1px solid var(--fw-line)}.fw-compare table{border-collapse:collapse;width:100%;min-width:520px;font-size:14px}.fw-compare th,.fw-compare td{padding:20px 22px;border-bottom:1px solid var(--fw-line);text-align:left;line-height:1.4}.fw-compare th{font-weight:650;color:var(--fw-title)}.fw-compare thead th{background:#00000005}.fw-compare tr:last-child th,.fw-compare tr:last-child td{border-bottom:0}.fw-compare__featured{background:#869a8920;font-weight:650;color:var(--fw-title)}
@container(max-width:600px){.fw-compare th,.fw-compare td{padding:15px 13px}}
</style>

<schema>
{
  "schema_version": 1,
  "type": "foundation_comparison",
  "name": "Foundation / Comparison table",
  "category": "features",
  "description": "Editable two-column comparison with clear rows and mobile-friendly table.",
  "version": "1.0.0",
  "icon": "columns",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Overline",
      "default": "THE DIFFERENCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The details, side by side."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Supporting text",
      "default": "Help people understand exactly what makes your offering different."
    },
    {
      "type": "text",
      "id": "feature_heading",
      "label": "First column heading",
      "default": "Features"
    },
    {
      "type": "text",
      "id": "ours_heading",
      "label": "Featured column heading",
      "default": "This collection"
    },
    {
      "type": "text",
      "id": "theirs_heading",
      "label": "Comparison heading",
      "default": "Other options"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "light"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "default": 80,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 80,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Comparison table (edit values)",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "label": "Feature one",
            "ours": "Included",
            "theirs": "Varies"
          }
        },
        {
          "type": "item",
          "settings": {
            "label": "Feature two",
            "ours": "Included",
            "theirs": "Varies"
          }
        },
        {
          "type": "item",
          "settings": {
            "label": "Feature three",
            "ours": "Included",
            "theirs": "Varies"
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Comparison row",
      "limit": 15,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Feature",
          "default": "Considered design"
        },
        {
          "type": "text",
          "id": "ours",
          "label": "Featured value",
          "default": "Included"
        },
        {
          "type": "text",
          "id": "theirs",
          "label": "Comparison value",
          "default": "Varies"
        }
      ]
    }
  ]
}
</schema>
